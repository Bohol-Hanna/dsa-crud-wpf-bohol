<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
    <TextBlock HorizontalAlignment="Center" Height="25" Margin="0,10,0,0" TextWrapping="Wrap" Text="Shopping Cart System" VerticalAlignment="Top" Width="158" FontSize="16"/>

    <DataGrid x:Name="ShopGrid" ItemsSource="{Binding Products}" AutoGenerateColumns="False"  Margin="32,73,419,132">
        <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
            <DataGridTextColumn Header="Name" Binding="{Binding Product}" Width="*"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>


    <TextBlock HorizontalAlignment="Left" Height="18" Margin="32,342,0,0" TextWrapping="Wrap" Text="ID" VerticalAlignment="Top" Width="19" FontSize="13"/>
    <TextBox Name="IDTextBox" HorizontalAlignment="Left" Height="26" Margin="51,338,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50"/>

    <TextBlock HorizontalAlignment="Left" Height="19" Margin="140,342,0,0" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" Width="35" FontSize="13"/>
    <TextBox Name="NameTextBox" HorizontalAlignment="Left" Height="26" Margin="180,338,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="125"/>

    <TextBlock HorizontalAlignment="Left" Height="19" Margin="353,342,0,0" TextWrapping="Wrap" Text="Description" VerticalAlignment="Top" Width="76" FontSize="13"/>
    <TextBox Name="DescTextBox" HorizontalAlignment="Left" Height="26" Margin="428,338,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="132"/>

    <TextBlock HorizontalAlignment="Left" Height="18" Margin="615,342,0,0" TextWrapping="Wrap" Text="Price" VerticalAlignment="Top" Width="31" FontSize="13"/>
    <TextBox Name="PriceTextBox" HorizontalAlignment="Left" Height="26" Margin="651,338,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="109"/>

    <Button Content="Add" HorizontalAlignment="Left" Height="27" Margin="24,387,0,0" VerticalAlignment="Top" Width="109" Click="AddButton_Click"/>
    <Button Content="Remove" HorizontalAlignment="Left" Height="27" Margin="180,387,0,0" VerticalAlignment="Top" Width="109" Click="RemoveButton_Click"/>
    <Button Content="Clear" HorizontalAlignment="Left" Height="27" Margin="350,387,0,0" VerticalAlignment="Top" Width="108" Click="ClearButton_Click"/>
    <Button Content="Add To Cart" HorizontalAlignment="Left" Height="27" Margin="506,387,0,0" VerticalAlignment="Top" Width="108" Click="AddCartButton_Click"/>
    <Button Content="Remove From Cart" HorizontalAlignment="Left" Height="27" Margin="660,387,0,0" VerticalAlignment="Top" Width="108" Click="RemoveCartButton_Click"/>
    <DataGrid x:Name="ShoppingGrid" ItemsSource="{Binding Carts}" AutoGenerateColumns="False"  Margin="420,73,32,132">
        <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding IDUlit}" Width="*"/>
            <DataGridTextColumn Header="Name" Binding="{Binding ProductUlit}" Width="*"/>
            <DataGridTextColumn Header="Description" Binding="{Binding DescriptionUlit}" Width="*"/>
            <DataGridTextColumn Header="Price" Binding="{Binding PriceUlit}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
    <TextBlock HorizontalAlignment="Left" Height="25" Margin="144,43,0,0" TextWrapping="Wrap" Text="Available Product" VerticalAlignment="Top" Width="124" FontSize="16"/>
    <TextBlock HorizontalAlignment="Left" Height="25" Margin="537,43,0,0" TextWrapping="Wrap" Text="Shopping Cart" VerticalAlignment="Top" Width="114" FontSize="16"/>
    </Grid>
</Window>
